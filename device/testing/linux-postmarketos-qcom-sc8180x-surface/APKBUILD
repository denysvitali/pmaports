4ab2ae1e6e2e590ab394c948588665d0766368db2e785f5cff1225d6e51726508c5e475588f753360f8735658f1e89ef3c03a2cdbe20644d9f758ea2c972b76a  config-postmarketos-qcom-sc8180x-surface.aarch64
"
